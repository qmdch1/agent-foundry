FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
COPY requirements-sandbox.lock /tmp/requirements-sandbox.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-sandbox.lock \
    && useradd --uid 10001 --create-home tool
USER 10001:10001
WORKDIR /tool
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/tool
