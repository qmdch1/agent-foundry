# Create real random local values using: foundry init-env
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
FOUNDRY_DATABASE_URL=postgresql://foundry:CHANGE_DATABASE_PASSWORD@localhost:55439/foundry
FOUNDRY_API_KEY=CHANGE_API_KEY
FOUNDRY_ADMIN_KEY=CHANGE_ADMIN_KEY
FOUNDRY_PROMPT_HASH_KEY=CHANGE_HASH_KEY
FOUNDRY_JOB_ENCRYPTION_KEY=CHANGE_ENCRYPTION_KEY
FOUNDRY_LLM_API_KEY=
FOUNDRY_LLM_BASE_URL=https://api.openai.com/v1
# Explicit allowlist for private/local OpenAI-compatible API hosts, if needed.
FOUNDRY_LLM_PRIVATE_HOSTS=[]
FOUNDRY_WEB_SESSION_HOURS=8
FOUNDRY_MAIN_MODEL=
FOUNDRY_ROUTER_MODEL=
FOUNDRY_EVALUATOR_MODEL=
FOUNDRY_BUILDER_MODEL=
FOUNDRY_CATALOG_ENABLED=true
FOUNDRY_CATALOG_SYNC_SECONDS=60
FOUNDRY_CATALOG_MAX_PROGRAMS=10000
# Counterfactual token estimates, not measured savings. Observed LLM responses take precedence.
FOUNDRY_TOKEN_ESTIMATE_BYTES_PER_TOKEN=4
FOUNDRY_TOKEN_ESTIMATE_OVERHEAD=100
FOUNDRY_SEARCH_TOP_K=5
FOUNDRY_SEARCH_MIN_SCORE=0.08
FOUNDRY_DIRECT_THRESHOLD=0.94
FOUNDRY_ROUTER_THRESHOLD=0.8
FOUNDRY_CREATION_THRESHOLD=0.65
FOUNDRY_BUILDER_RETRY_COUNT=2
FOUNDRY_EXECUTION_TIMEOUT=30
FOUNDRY_MEMORY_MB=256
FOUNDRY_CPU=1
FOUNDRY_EXECUTOR_CONCURRENCY=4
FOUNDRY_TOOL_REPOSITORY=https://github.com/qmdch1/agent-tools.git
FOUNDRY_TOOL_REPOSITORY_ROOT=../agent-tools
FOUNDRY_GIT_BRANCH=main
FOUNDRY_GIT_PUSH=true
# Optional fine-grained token for only the agent-tools repository. Never place it in the Registry.
FOUNDRY_GIT_TOKEN=
FOUNDRY_STATE_ROOT=.state
FOUNDRY_BUILD_COST_UNITS=50000
FOUNDRY_EXPECTED_REUSES=20
FOUNDRY_MINIMUM_COST_RATIO=1.5
FOUNDRY_HTTP_ALLOWED_HOSTS=[]
FOUNDRY_APPROVED_DEPENDENCIES={}
# Set the host Docker socket group for Linux Compose deployment.
DOCKER_GID=0

# DB-using programs share the central database via an internal Docker network.
FOUNDRY_TOOL_DATABASE_NETWORK=agent-foundry-database
FOUNDRY_TOOL_DATABASE_HOST=postgres
FOUNDRY_TOOL_DATABASE_PORT=5432
FOUNDRY_TOOL_DATABASE_CONNECTION_LIMIT=2
FOUNDRY_TOOL_DATABASE_STATEMENT_TIMEOUT_MS=5000
FOUNDRY_TOOL_DATABASE_LOCK_TIMEOUT_MS=1000
